#--------------------------------------------------------------------
# Copia este archivo como ".env" (con el punto al inicio) y llena tus datos.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Dirección donde vive la aplicación (termina en /)
app.baseURL = 'https://bixosdement.com/inventario-hotwheels/'
app.forceGlobalSecureRequests = true

# Base de datos MySQL (la creas en cPanel > Bases de datos MySQL)
database.default.hostname = localhost
database.default.database = NOMBRE_DE_LA_BASE
database.default.username = USUARIO_DE_LA_BASE
database.default.password = CONTRASEÑA_DE_LA_BASE
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
